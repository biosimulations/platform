# Local-development defaults for the Nuxt frontend.
# Copy to frontend/.env (gitignored). Loaded automatically by Nuxt's built-in
# dotenv at dev-server startup.
#
# We use NUXT_PUBLIC_<KEY> names (and NUXT_<KEY> for server-only keys) — that
# matches how Nuxt's runtime config override works at process startup and how
# the deployment ConfigMaps are wired (see kustomize/config/*/frontend.env),
# so local dev exercises the same code path as prod.

NUXT_PUBLIC_BASE_URL=http://localhost:4200
NUXT_PUBLIC_API_URL=http://localhost:8000
NUXT_PUBLIC_BIOSIMULATIONS_API_URL=https://api.biosimulations.org
# Legacy biosimulations.org API used directly by the project detail page
# (pages/projects/[id].vue: /projects/{id}/summary, /files/{id}, /specifications/{id}).
# Same public host as NUXT_PUBLIC_BIOSIMULATIONS_API_URL above.
NUXT_PUBLIC_LEGACY_API_URL=https://api.biosimulations.org

# Legacy BioSimulators registry and ontologies use the same-origin /biosimulators-api
# proxy (server/routes/biosimulators-api/[...path].get.ts) because the upstream
# CORS allowlist excludes our deployed hosts. Server-only upstream override:
# NUXT_LEGACY_SIMULATORS_API_URL=https://api.biosimulators.org

# Server-only upstreams for the verify-model run-precheck proxies (/biosimulations-api/runs/{id},
# /simdata-api/datasets/{id}/metadata). Neither service's CORS allowlist includes our deployed hosts.
# NUXT_LEGACY_RUNS_API_URL=https://api.biosimulations.org
# NUXT_SIMDATA_API_URL=https://simdata.api.biosimulations.org

# Server-only: in-cluster URL Nitro uses for SSR-time fetches to the backend
# (skips the public ingress in K8s). In local dev there's no separate
# in-cluster API, so point this at the same host as NUXT_PUBLIC_API_URL.
NUXT_API_URL=http://localhost:8000

NUXT_PUBLIC_AUTH0_DOMAIN=dev-bu7yo7484tyxu6a1.us.auth0.com
# Local-development SPA (auth0-pulumi biosim-platform: auth0_biosim_platform_local, output
# biosim_spa_local_client_id). It allows exactly http://localhost:4200. The production SPA
# (GA9L0b7xoDELHoHPfpdx4SSgo8S1fAkP, used by the GKE/RKE ConfigMaps) is HTTPS-only and rejects localhost.
NUXT_PUBLIC_AUTH0_CLIENT_ID=WFNcITp0mjLiNLE9FltmMQmrglO8UCrg
NUXT_PUBLIC_AUTH0_AUDIENCE=https://api.biosimulations.org
