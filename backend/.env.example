# Local-development defaults for the backend service.
# Copy to backend/.env (gitignored). Loaded by python-dotenv from
# biosim_server/config.py — `load_dotenv()` walks up from the process CWD,
# so running `cd backend && uv run uvicorn ...` picks this file up.

# File storage backend. "local" uses ./local_cache for OMEX caching and lets
# you run without GCS credentials. "minio" uses the S3 service from
# `docker compose --profile minio up -d`. "gcs" is the production default.
STORAGE_BACKEND=local
STORAGE_LOCAL_CACHE_DIR=./local_cache

# If STORAGE_BACKEND=minio, these match the compose service.
# STORAGE_BUCKET=platform-local
# STORAGE_ENDPOINT_URL=http://localhost:9000
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=minioadmin

# Infra (matches compose.yaml).
TEMPORAL_SERVICE_URL=localhost:7233
MONGODB_URI=mongodb://localhost:27017
# The local Mongo above is empty. To work on the project search API
# (GET /projects) locally you need real project data, which lives in the hosted
# biosimulations-prod Mongo. Point MONGODB_URI at the hosted read-only URI for
# that work. Get the URI from your overlay's secrets.dat (kustomize/overlays/*/,
# key MONGODB_URI) or the ../deployment / ../secrets repos — never commit it.
# MONGODB_URI=mongodb+srv://READONLY_USER:PASSWORD@HOST/biosimulations-prod?retryWrites=true&w=majority
# MONGODB_DATABASE=biosimulations-prod

# External APIs. Defaults point at production biosimulations.org — the local
# backend calls these for real simulation runs. Override only to target a
# staging instance or a mock.
# BIOSIMULATIONS_API_BASE_URL=https://api.biosimulations.org
# SIMDATA_API_BASE_URL=https://simdata.api.biosimulations.org
# BIOSIMULATORS_API_BASE_URL=https://api.biosimulators.org

# Additional CORS origins (comma-separated). Local dev usually doesn't need
# this — the built-in list already covers localhost ports. Deployments
# (kustomize overlays) set this to the deployed frontend host(s).
# CORS_EXTRA_ORIGINS=https://example.org,https://example-dev.org

# Startup gate (biosim_server/config.py :: Auth0Settings.required). True by
# default: the API refuses to start when AUTH0_DOMAIN/AUTH0_AUDIENCE are
# missing or malformed, so a misconfigured deployment crash-loops visibly
# rather than reporting healthy and failing every authenticated request.
# Set to false only to run deliberately without an identity provider --
# every endpoint behind get_current_user then returns 503.
# AUTH_REQUIRED=true

AUTH0_DOMAIN=dev-bu7yo7484tyxu6a1.us.auth0.com
AUTH0_AUDIENCE=https://api.biosimulations.org
AUTH0_ISSUER=https://dev-bu7yo7484tyxu6a1.us.auth0.com/

# Custom claims carrying role names and email. Auth0 access tokens include
# NEITHER by default: roles require an assigned Auth0 Role to exist at all, and
# email lives only on the ID token / userinfo unless stamped on separately.
# Both are added by a Post-Login Action.
#
# THE ACTION IS VERSION-CONTROLLED: auth0/actions/post-login.js (repo root).
# See auth0/README.md for the required Action secrets, the M2M scopes, the
# dashboard deploy procedure, and the post-deploy smoke check.
#
# These two values must match the namespace the Action uses. They are namespace
# URIs, not URLs -- nothing dereferences them -- and they do not need to change
# if the Auth0 tenant changes.

AUTH0_ROLES_CLAIM=https://api.biosimulations.org/roles
AUTH0_EMAIL_CLAIM=https://api.biosimulations.org/email

# Access-token permissions (Auth0 RBAC "Add Permissions in the Access Token")
# plus the OAuth `scope` claim. Override only if a custom Action uses a
# different claim name. Missing/malformed → no permissions (fail closed).
# AUTH0_PERMISSIONS_CLAIM=permissions

# Optional multi-issuer map. Omit to keep the single AUTH0_DOMAIN/AUDIENCE
# configuration above. When set, each issuer may only mint the audiences listed
# under that issuer — not a cross-product of all issuers × all audiences.
# AUTH0_TRUSTED_ISSUERS={"https://tenant.us.auth0.com/":{"audiences":["https://api.biosimulations.org"],"jwks_uri":"https://tenant.us.auth0.com/.well-known/jwks.json"}}

# Which token the API accepts: access tokens only, never OIDC ID tokens.
# See backend/docs/auth0-tokens-claims-endpoints.md.

# M2M application credentials for the Auth0 Management API. Optional --
# PATCH/DELETE /api/v1/me return 503 when unset. Create a Machine to Machine
# application in the Auth0 dashboard authorized for the Auth0 Management API
# with the `update:users` and `delete:users` scopes, then fill these in.
# AUTH0_MANAGEMENT_CLIENT_ID=
# AUTH0_MANAGEMENT_CLIENT_SECRET=

# Optional hosted password-reset tickets. Blank disables the endpoint.
# SPA application ID (not M2M ID); backend M2M needs create:user_tickets.
# Configure New Universal Login and the SPA Application Login URI in Auth0.
# AUTH0_PASSWORD_RESET_CLIENT_ID=<SPA_APPLICATION_CLIENT_ID>

# Step-up policy for the hosted password change (decision D-12). Possessing an
# access token is not proof of a recent sign-in, so a token may have to carry a
# fresh interactive-authentication timestamp as well. `auth_time` is the OIDC
# standard claim; it must be stamped onto the access token by the Post-Login
# Action (auth0/actions/post-login.js) before this can be turned on.
# A refreshed token and `iat` are deliberately NOT accepted as evidence.
# Default false -- the startup gate logs a warning while the reset endpoint is
# configured without it. Enable before exposing the reset UI.
# AUTH0_PASSWORD_RESET_REQUIRE_RECENT_AUTH=false
# AUTH0_PASSWORD_RESET_MAX_AUTH_AGE_SECONDS=300
# AUTH0_AUTH_TIME_CLAIM=auth_time

# Password-reset abuse quota. Metered per pod, per (issuer, subject), on its own
# window -- independent of the workflow-start budget (RATE_LIMIT_*). The
# effective cluster-wide ceiling is up to replica_count (3) times these values.
# RATE_LIMIT_PASSWORD_RESET_PER_WINDOW=5
# RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=300

# Page-aggregation quota for GET /projects/{id}/page and GET /runs/{id}/page.
# Both routes are public, and each request fans out to 3-4 upstream calls
# against biosimulations.org, so they are metered per client IP (a token
# neither raises the ceiling nor resets the bucket -- the routes stay
# unauthenticated by design). Same per-pod caveat as above.
# RATE_LIMIT_PAGE_PER_WINDOW=60
# RATE_LIMIT_PAGE_WINDOW_SECONDS=60

# Ceiling on one upstream JSON body's DECODED size (bytes) for the page
# aggregations. Content-Length and Content-Encoding cannot get past it, and a
# breach is a sanitized 502 rather than a truncated payload. Provisional --
# raise it per cluster if a legitimate files/specifications/logs response is
# larger than 16 MiB.
# UPSTREAM_MAX_RESPONSE_BYTES=16777216
