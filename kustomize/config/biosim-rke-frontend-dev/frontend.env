# WIP-preview frontend on the RKE cluster, pointed at the RKE prod-tier
# backend so the preview exercises the same API behavior end users see.
#
# Nuxt runtime config override — uses NUXT_PUBLIC_<KEY> at process startup.
# Bare names (API_URL etc.) are only picked up at build time, too early for
# a runtime-configured container image.
NUXT_PUBLIC_BASE_URL=https://biosim-dev.cam.uchc.edu
NUXT_PUBLIC_API_URL=https://api.biosim.cam.uchc.edu
NUXT_PUBLIC_BIOSIMULATIONS_API_URL=https://api.biosimulations.org
NUXT_PUBLIC_LEGACY_API_URL=https://api.biosimulations.org
# No in-namespace api Service, so SSR fetches also go through the public URL.
NUXT_API_URL=https://api.biosim.cam.uchc.edu
