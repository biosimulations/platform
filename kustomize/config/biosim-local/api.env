# Rate limiting for workflow-starting endpoints (TODO P1 #10). PER-POD -- api
# runs 3 replicas and there is no shared counter, so the effective GLOBAL
# ceiling is up to 3x these numbers if traffic spreads evenly across pods.
# See kustomize/README-config.md and backend/CLAUDE.md for the full model.
RATE_LIMIT_AUTHENTICATED_PER_WINDOW=30
RATE_LIMIT_ANONYMOUS_PER_WINDOW=5
RATE_LIMIT_WINDOW_SECONDS=60