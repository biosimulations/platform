# Nuxt runtime config override. Nuxt reads NUXT_PUBLIC_<KEY> at process
# startup to override runtimeConfig.public.<key>, and NUXT_<KEY> for
# server-only keys like runtimeConfig.apiUrl. Bare names (API_URL etc.)
# are picked up at *build* time only, which is too early for a runtime-
# configured container image.
NUXT_PUBLIC_BASE_URL=https://biosim.biosimulations.org
NUXT_PUBLIC_API_URL=https://api.biosim.biosimulations.org
NUXT_PUBLIC_BIOSIMULATIONS_API_URL=https://api.biosimulations.org
NUXT_API_URL=http://api:8000
